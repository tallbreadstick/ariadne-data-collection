# Postgres (use the flake devshell defaults or your own instance).
DATABASE_URL=postgres://ariadne:ariadne@127.0.0.1:5432/ariadne_metrics

# Shared secret the extension sends as: Authorization: Bearer <key>
ARIADNE_INGEST_API_KEY=change-me-before-production

# TLS certificate paths (PEM). Generate with mkcert or openssl for local dev.
ARIADNE_TLS_CERT=./certs/cert.pem
ARIADNE_TLS_KEY=./certs/key.pem

# Optional plain HTTP port that 301-redirects to HTTPS (0 disables).
ARIADNE_HTTP_REDIRECT_PORT=8080

# Bind address for HTTPS.
ARIADNE_HTTPS_ADDR=0.0.0.0:8443

# Max JSON body size in bytes.
ARIADNE_MAX_BODY_BYTES=262144

# Browser DB UI (pgweb) port when using ./run_server.sh
ARIADNE_PGWEB_PORT=8081

RUST_LOG=ariadne_data_collection=debug,tower_http=info,sqlx=warn
